# Required — extraction (L1) and the QA gate (L2) run on Haiku 4.5.
# Get a key at https://console.anthropic.com/ and paste it after the '='.
ANTHROPIC_API_KEY=

# Optional — override the default store location (~/.mnemon/store).
# Useful when isolating a project's memory from your default store.
# MNEMON_DATA=/absolute/path/to/your/store
